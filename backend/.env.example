# Copy to `.env` and fill in the key for the provider you want.
# An LLM API key is required — without one the console asks you to enter it.

# --- Model -------------------------------------------------------------
# Set OPENAI_API_KEY or ANTHROPIC_API_KEY (or run `ant auth login`).
#
# Provider: auto | openai | anthropic
#   auto      -- use whichever key is set (Anthropic if both are present)
#   openai    -- require OPENAI_API_KEY
#   anthropic -- require ANTHROPIC_API_KEY (or ANTHROPIC_AUTH_TOKEN / `ant auth login`)
CREWOPS_LLM_PROVIDER=auto

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override. Defaults: gpt-4.1 (openai), claude-opus-5 (anthropic).
# CREWOPS_MODEL=gpt-4.1
# CREWOPS_MODEL=claude-opus-5

# --- Persistence -------------------------------------------------------
# Default is SQLite next to the app. Postgres via `docker compose up -d db`:
# CREWOPS_DATABASE_URL=postgresql+psycopg://crewops:crewops@localhost:5432/crewops
CREWOPS_PERSIST_TRACES=true

# --- World -------------------------------------------------------------
# The dataset is frozen here; the virtual clock starts at this instant.
CREWOPS_SNAPSHOT_UTC=2026-09-14T18:00:00Z
# RNG seed for the synthetic world. On startup, if data/data-seed-{n}/ is
# empty, the generator fills it and the backend loads that snapshot.
CREWOPS_DATA_SEED=42
# Optional override. If this directory already has a complete snapshot,
# generation is skipped.
# CREWOPS_DATA_DIR=./data

# --- Watchers ----------------------------------------------------------
CREWOPS_SCHEDULER_ENABLED=true
CREWOPS_WATCHER_INTERVAL_SECONDS=300

# --- CORS --------------------------------------------------------------
CREWOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
